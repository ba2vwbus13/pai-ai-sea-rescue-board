<?xml version="1.0"?>
<!-- デモ動画用の Gazebo 画面: 3D ビューだけを表示し、パネル類は出さない -->
<window>
  <width>2048</width>
  <height>1152</height>
  <position_x>0</position_x>
  <position_y>0</position_y>
  <style material_theme="Dark" material_primary="DeepOrange" material_accent="LightBlue"/>
  <menus><drawer default="false" visible="false"/></menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.5 0.5 0.5</ambient_light>
  <background_color>0.6 0.7 0.9</background_color>
  <camera_pose>-25 -30 25 0 0.55 0.9</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui><property key="state" type="string">floating</property>
    <property key="width" type="double">5</property><property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property></gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui><property key="state" type="string">floating</property>
    <property key="width" type="double">5</property><property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property></gz-gui>
</plugin>
<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui><property key="state" type="string">floating</property>
    <property key="width" type="double">5</property><property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property></gz-gui>
</plugin>
<plugin filename="MarkerManager" name="Marker manager">
  <gz-gui><property key="state" type="string">floating</property>
    <property key="width" type="double">5</property><property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property></gz-gui>
</plugin>
